#!/bin/sh
# Pegasus's boot shim: the one hop that runs before Pegasus is on PATH at all.
#
# `pegasus setup` copies this exact file to the directory
# `pegasus.ports.filesystem.FileSystem.bin_dir` names for this platform (on
# Linux, `~/.local/bin`), so it has to work standing alone, with nothing else
# installed yet. That is also why it is `sh`, not Python: it must run before
# a private interpreter exists to run it, so it cannot `import pegasus` and
# cannot ask that port where the venv lives -- it mirrors the answer instead.
#
# Keep this in sync by hand with the POSIX branch of
# `PosixFileSystem.data_dir` in src/pegasus/infra/fs_posix.py: same
# `XDG_DATA_HOME`-if-absolute-else-`~/.local/share` rule, same
# "pegasus-harness" suffix.
set -eu

case "${XDG_DATA_HOME:-}" in
    /*) data_dir="$XDG_DATA_HOME/pegasus-harness" ;;
    *) data_dir="$HOME/.local/share/pegasus-harness" ;;
esac

python="$data_dir/venv/bin/python"

# The shim can outlive its venv -- a person can delete `~/.local/share` by
# hand, or a botched provisioning run can leave nothing behind it. `exec`ing
# straight at a missing interpreter would fail with "No such file or
# directory" and no hint about what to do next.
#
# It does not point at `pegasus setup`: that command builds the venv out of a
# checkout's lockfile and shim, and an installed Pegasus keeps neither. What
# actually works is installing again from the release, which is safe to
# repeat.
if [ ! -x "$python" ]; then
    echo "pegasus: no private virtual environment at $data_dir/venv -- install again from the release to rebuild it" >&2
    exit 1
fi

exec "$python" -m pegasus "$@"
