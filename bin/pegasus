#!/usr/bin/env python3
"""Install and validate the clean Pegasus Harness v2 runtime."""
from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import pwd
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SOURCE = ROOT / "source"
MARKER = ".pegasus-harness-state.json"
CLIENTS = ("opencode", "claude-code")
OPENCODE_INSTALLER = "https://opencode.ai/install"
CBM_INSTALLER = "https://raw.githubusercontent.com/DeusData/codebase-memory-mcp/main/install.sh"


def fail(message: str) -> None:
    raise RuntimeError(message)


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def target_home(user: str) -> Path:
    try:
        account = pwd.getpwnam(user)
    except KeyError:
        fail(f"target user does not exist: {user}")
    home = Path(account.pw_dir)
    if not home.is_dir() or home.stat().st_uid != account.pw_uid:
        fail(f"target home is missing or not owned by {user}: {home}")
    return home


def run_as_target(user: str, args: list[str]) -> int:
    staging = Path(tempfile.mkdtemp(prefix="pegasus-harness-", dir="/tmp"))
    staging.chmod(0o755)
    try:
        (staging / "bin").mkdir()
        shutil.copy2(Path(__file__).resolve(), staging / "bin" / "pegasus")
        (staging / "bin" / "pegasus").chmod(0o755)
        shutil.copytree(SOURCE, staging / "source")
        return subprocess.run([
            "sudo", "-u", user, "-H", "env", f"HOME={target_home(user)}",
            "PATH=/usr/local/bin:/usr/bin:/bin", sys.executable,
            str(staging / "bin" / "pegasus"), "--as-target", *args,
        ], check=False).returncode
    finally:
        shutil.rmtree(staging, ignore_errors=True)


def paths() -> dict[str, Path]:
    home = Path.home()
    config = home / ".config" / "opencode"
    data = home / ".local" / "share" / "pegasus-harness"
    return {"home": home, "config": config, "data": data, "state": data / MARKER,
            "bin": home / ".local" / "bin", "claude": home / ".claude"}


def selected_clients(client: str) -> tuple[str, ...]:
    return CLIENTS if client == "all" else (client,)


def assets() -> list[tuple[Path, Path]]:
    result: list[tuple[Path, Path]] = []
    for root, destination in ((SOURCE / "agents", Path("agents")), (SOURCE / "opencode" / "prompts", Path("prompts"))):
        result.extend((path, destination / path.relative_to(root)) for path in root.rglob("*") if path.is_file())
    skill_root = SOURCE / "core" / "skills"
    result.extend((path, Path("skills") / path.relative_to(skill_root)) for path in skill_root.rglob("*") if path.is_file())
    return sorted(result, key=lambda item: item[1].as_posix())


def write_owned(path: Path, content: bytes, ownership: list[dict[str, str]]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(content)
    path.chmod(0o600)
    ownership.append({"path": str(path), "sha256": digest(path)})


def clean_config(cbm: Path) -> dict[str, object]:
    config = json.loads((SOURCE / "opencode" / "opencode.json").read_text(encoding="utf-8"))
    config["mcp"]["codebase-memory-mcp"]["command"] = [str(cbm)]
    for agent in config["agent"].values():
        if isinstance(agent, dict) and isinstance(agent.get("prompt"), str):
            agent["prompt"] = agent["prompt"].replace("../agents/", "./agents/")
    return config


def materialize(target: dict[str, Path], cbm: Path, clients: tuple[str, ...]) -> None:
    ownership: list[dict[str, str]] = []
    if "opencode" in clients:
        config = target["config"]
        write_owned(config / "opencode.json", (json.dumps(clean_config(cbm), indent=2) + "\n").encode(), ownership)
        for source, relative in assets():
            write_owned(config / relative, source.read_bytes(), ownership)
        installed = target["data"] / "bin" / "pegasus"
        write_owned(installed, Path(__file__).resolve().read_bytes(), ownership)
        installed.chmod(0o755)
        launcher = target["bin"] / "pegasus"
        launcher.parent.mkdir(parents=True, exist_ok=True)
        launcher.symlink_to(installed)
        ownership.append({"path": str(launcher), "symlink": str(installed)})
    if "claude-code" in clients:
        write_owned(target["claude"] / "CLAUDE.md", (SOURCE / "adapters" / "claude-code" / "CLAUDE.md").read_bytes(), ownership)
        skill_root = SOURCE / "core" / "skills"
        for source in skill_root.rglob("*"):
            if source.is_file():
                write_owned(target["claude"] / "skills" / source.relative_to(skill_root), source.read_bytes(), ownership)
    target["state"].parent.mkdir(parents=True, exist_ok=True)
    target["state"].write_text(json.dumps({"schema": "pegasus-harness/v2", "installed_at_utc": dt.datetime.now(dt.timezone.utc).isoformat(), "clients": clients, "ownership": ownership}, indent=2) + "\n", encoding="utf-8")
    target["state"].chmod(0o600)


def ensure_prerequisites() -> None:
    if sys.platform != "linux" or os.geteuid() == 0:
        fail("internal target mode requires an unprivileged Linux user")


def install(args: argparse.Namespace) -> int:
    ensure_prerequisites()
    target = paths()
    clients = selected_clients(args.client)
    if target["state"].exists():
        fail("Pegasus is already installed for this user; uninstall it before installing again")
    if "opencode" in clients and target["config"].exists():
        fail("clean installation requires an unused ~/.config/opencode directory")
    if "claude-code" in clients and target["claude"].exists():
        fail("clean installation requires an unused ~/.claude directory")
    cbm = target["bin"] / "codebase-memory-mcp"
    if "opencode" in clients and not args.skip_opencode_install:
        subprocess.run(["bash", "-c", f"curl --proto '=https' --tlsv1.2 -fsSL {OPENCODE_INSTALLER} | bash"], check=True)
    if "opencode" in clients and not args.skip_cbm_install:
        subprocess.run(["bash", "-c", f"curl --proto '=https' --tlsv1.2 -fsSL {CBM_INSTALLER} | bash -s -- --skip-config"], check=True)
    if "opencode" in clients and (not cbm.is_file() or not os.access(cbm, os.X_OK)):
        fail(f"CBM executable is unavailable: {cbm}")
    materialize(target, cbm, clients)
    print(f"INSTALLED clients={','.join(clients)}")
    return 0


def validate(args: argparse.Namespace) -> int:
    ensure_prerequisites()
    target = paths()
    errors: list[str] = []
    try:
        state = json.loads(target["state"].read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        errors.append(f"invalid installation state: {error}")
        state = {}
    if state.get("schema") != "pegasus-harness/v2":
        errors.append("missing v2 installation state")
    for entry in state.get("ownership", []):
        path = Path(entry["path"])
        if "symlink" in entry:
            if not path.is_symlink() or os.readlink(path) != entry["symlink"]: errors.append(f"changed launcher: {path}")
        elif not path.is_file() or digest(path) != entry["sha256"]:
            errors.append(f"changed managed asset: {path}")
    if "opencode" in selected_clients(args.client):
        try: json.loads((target["config"] / "opencode.json").read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as error: errors.append(f"invalid OpenCode config: {error}")
        cbm = target["bin"] / "codebase-memory-mcp"
        if not cbm.is_file() or not os.access(cbm, os.X_OK): errors.append("CBM executable is unavailable")
    if errors:
        print("\n".join(f"BLOCKING: {error}" for error in errors))
        return 1
    print("PASS: v2 assets, configuration, and CBM availability are valid")
    return 0


def uninstall() -> int:
    target = paths()
    state = json.loads(target["state"].read_text(encoding="utf-8"))
    if state.get("schema") != "pegasus-harness/v2": fail("missing v2 installation state")
    for entry in reversed(state["ownership"]):
        path = Path(entry["path"])
        if "symlink" in entry:
            if path.is_symlink(): path.unlink()
        elif path.is_file() and digest(path) == entry["sha256"]: path.unlink()
    target["state"].unlink()
    print("UNINSTALLED v2 managed assets")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--as-target", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--target-user", default=os.environ.get("USER", ""))
    parser.add_argument("--client", choices=(*CLIENTS, "all"), default="opencode")
    commands = parser.add_subparsers(dest="command", required=True)
    install_parser = commands.add_parser("install")
    install_parser.add_argument("--skip-opencode-install", action="store_true")
    install_parser.add_argument("--skip-cbm-install", action="store_true")
    commands.add_parser("validate")
    commands.add_parser("uninstall")
    args = parser.parse_args()
    if not args.target_user: fail("--target-user is required")
    if not args.as_target and args.target_user != pwd.getpwuid(os.geteuid()).pw_name:
        return run_as_target(args.target_user, ["--as-target", *sys.argv[1:]])
    if args.command == "install": return install(args)
    if args.command == "validate": return validate(args)
    return uninstall()


if __name__ == "__main__":
    try: raise SystemExit(main())
    except (RuntimeError, subprocess.CalledProcessError) as error:
        print(f"ERROR: {error}", file=sys.stderr)
        raise SystemExit(1)
