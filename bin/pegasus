ROOT = Path(__file__).resolve().parents[1]
CATALOG_PATH = ROOT / "manifests" / "artifact-catalog.json"
CONTRACT_PATH = ROOT / "manifests" / "release-contract.json"
CLIENTS = ("opencode", "claude-code")
RELEASE = "3.1.0"
RC_TAG = re.compile(r"^v3\.1\.0-rc\.[1-9][0-9]*$")
CONTEXT7 = {
    "id": "context7",
    "config_key": "context7",
    "endpoint": "https://mcp.context7.com/mcp",
    "provider_managed": True,
    "integrity": None,
}
PROBE_TIMEOUT = 10
PROBE_DIAGNOSTIC_LIMIT = 512
SENSITIVE_PROBE_VALUE = re.compile(
    r"(?ix)(?P<key>\b(?:api[_-]?key|access[_-]?token|authorization|cookie|credential|password|passwd|secret|token)\b)(?P<quote>[\"']?)\s*(?P<separator>=|:)\s*(?P<value>(?:[\"'][^\"']*[\"']|(?:bearer\s+)?[^\s,;]+))"
)
SENSITIVE_BEARER_TOKEN = re.compile(r"(?i)\bbearer\s+[^\s,;]+")
NOTIFIER_PACKAGE = "@mohak34/opencode-notifier"
NOTIFIER_VERSION = "0.2.4"
NOTIFIER_INTEGRITY = "sha512-xsfmqr6scB43pi+fZ0R74xD63ELM0MqMZnR/9AWWSescEObYyAcXvaSgiXG/9b2KrXxc8NvcLqTOLPiVJOhKaw=="
PLAYWRIGHT_PACKAGE = "@playwright/mcp"
PLAYWRIGHT_VERSION = "0.0.79"
PLAYWRIGHT_PACKAGE_PATH = ROOT / "manifests" / "playwright-mcp-package.json"
PLAYWRIGHT_LOCK_PATH = ROOT / "manifests" / "playwright-mcp-package-lock.json"
PLAYWRIGHT_LOCK_PACKAGES = {
    "node_modules/@playwright/mcp": {
        "version": "0.0.79",
        "resolved": "https://registry.npmjs.org/@playwright/mcp/-/mcp-0.0.79.tgz",
        "integrity": "sha512-VpqD4a3vFyGQMY9sh3UJiO6wjcurggkljKfAyCHL0QWGY5m6Ehr3MNsAAHPDHO//n13g0PCjpHatAOiulrqdZQ==",
    },
    "node_modules/playwright": {
        "version": "1.63.0-alpha-2026-08-05",
        "resolved": "https://registry.npmjs.org/playwright/-/playwright-1.63.0-alpha-2026-08-05.tgz",
        "integrity": "sha512-zbGZUK+JYkoDV3cUgfvh2czTBJL34Gmz5gHVI25xiIpvYSR17Q1M7TS8hnwECUe+IkKaeXbKrSyJTyogm2DVWw==",
    },
    "node_modules/playwright-core": {
        "version": "1.63.0-alpha-2026-08-05",
        "resolved": "https://registry.npmjs.org/playwright-core/-/playwright-core-1.63.0-alpha-2026-08-05.tgz",
        "integrity": "sha512-YussvUybTfBtyYbGXWh43f+5kNP03wg98M6mu4DphYET7PSbNVajsdLGjWE1xrsjqOw32i2wFlRP7U5mcOpMZg==",
    },
}
FORBIDDEN_PAYLOAD_SOURCES = {
    "source/core/skills/lazy-load-prompt-audit/references/deployment-transport.md",
    "source/opencode/tui.json",
}


def fail(message: str) -> None:
    raise RuntimeError(message)


def sha256_bytes(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def digest(path: Path) -> str:
    return sha256_bytes(path.read_bytes())


def directory_digest(path: Path) -> str:
    """Hash a dependency tree so rollback removes only an unchanged install."""
    if not path.is_dir() or path.is_symlink():
        fail(f"dependency is not a real directory: {path}")
    records = []
    for item in sorted(path.rglob("*")):
        if item.is_dir():
            continue
        if item.is_symlink() or not item.is_file():
            fail(f"dependency contains an unsafe artifact: {item}")
        records.append(f"{item.relative_to(path).as_posix()}:{digest(item)}")
    return sha256_bytes("\n".join(records).encode())


def load_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        fail(f"invalid JSON: {path}: {error}")


def load_catalog() -> dict:
    return load_json(CATALOG_PATH)


def load_contract() -> dict:
    return load_json(CONTRACT_PATH)


def is_allowed_executable(path: str) -> bool:
    return path in {"install.sh", "bin/pegasus"}


def validate_playwright_lockfile(path: Path, package_path: Path = PLAYWRIGHT_PACKAGE_PATH) -> bool:
    package = load_json(package_path)
    if package != {"name": "pegasus-playwright-mcp", "private": True, "dependencies": {PLAYWRIGHT_PACKAGE: PLAYWRIGHT_VERSION}}:
        fail("Playwright package must contain one fixed dependency without lifecycle scripts")
    lockfile = load_json(path)
    packages = lockfile.get("packages")
    expected = set(PLAYWRIGHT_LOCK_PACKAGES)
    if lockfile.get("name") != package["name"] or lockfile.get("lockfileVersion") != 3 or lockfile.get("requires") is not True:
        fail("Playwright lockfile metadata does not match the fixed package")
    if not isinstance(packages, dict) or set(packages) - {""} != expected or packages.get("", {}).get("dependencies") != package["dependencies"]:
        fail("Playwright lockfile must contain the fixed package graph")
    for name, expected_package in PLAYWRIGHT_LOCK_PACKAGES.items():
        if any(packages[name].get(field) != value for field, value in expected_package.items()):
            fail("Playwright lockfile does not match the approved package graph")
    return True


def validate_notifier_lockfile(root: Path = ROOT) -> bool:
    package_path = root / "source/opencode/notifier/package.json"
    lock_path = root / "source/opencode/notifier/package-lock.json"
    package, lockfile = load_json(package_path), load_json(lock_path)
    if package.get("dependencies") != {NOTIFIER_PACKAGE: NOTIFIER_VERSION} or package.get("scripts"):
        fail("notifier package must be pinned without lifecycle scripts")
    packages = lockfile.get("packages")
    if not isinstance(packages, dict) or packages.get("", {}).get("dependencies") != {NOTIFIER_PACKAGE: NOTIFIER_VERSION}:
        fail("notifier lockfile must pin the root dependency")
    notifier = packages.get(f"node_modules/{NOTIFIER_PACKAGE}", {})
    if notifier.get("version") != NOTIFIER_VERSION or notifier.get("integrity") != NOTIFIER_INTEGRITY:
        fail("notifier lockfile has invalid package integrity")
    if any(not isinstance(item, dict) or not item.get("integrity") for name, item in packages.items() if name):
        fail("notifier lockfile has an unverified transitive package")
    return True


def validate_contract(contract: dict) -> bool:
    if contract.get("schema") != "pegasus-harness-release-contract/v3" or contract.get("version") != RELEASE:
        fail(f"release contract must be v{RELEASE}")
    dependencies = contract.get("dependencies")
    if not isinstance(dependencies, list) or {item.get("id") for item in dependencies} != {"cbm", "engram", "playwright"}:
        fail("release contract must declare exactly CBM, Engram, and Playwright")
    for item in dependencies:
        rendered = json.dumps(item).lower()
        if not item.get("version") or item["version"] == "latest":
            fail(f"dependency {item.get('id')} needs a fixed version")
        if "npx" in rendered or "latest" in rendered or "sh -c" in rendered or "bash -c" in rendered:
            fail(f"dependency {item['id']} uses forbidden mutable or shell execution")
        if not (item.get("source_url", "").startswith("https://") or item.get("source_url", "").startswith("release-bundle:")):
            fail(f"dependency {item['id']} needs an HTTPS release source")
        if not isinstance(item.get("install_argv"), list) or not isinstance(item.get("runtime_argv"), list):
            fail(f"dependency {item['id']} requires argv lists")
        integrity = item.get("integrity", {})
        if item["id"] == "cbm" and (len(integrity.get("sha256", "")) != 64 or not integrity.get("provenance")):
            fail("CBM requires curated bundle SHA-256 and provenance")
        if item["id"] == "engram" and len(integrity.get("sha256", "")) != 64:
            fail("Engram requires SHA-256")
        if item["id"] == "engram" and item.get("archive_layout") != {
                "members": ["CHANGELOG.md", "LICENSE", "README.md", "engram"],
                "executables": {"engram": "0755"}}:
            fail("Engram requires the fixed Linux amd64 archive layout")
        if item["id"] == "engram" and item.get("probe_argv") != ["{dependency}/engram", "--version"]:
            fail("Engram requires a standalone version probe")
        if item["id"] == "playwright":
            if (not integrity.get("package") or not integrity.get("lockfile")
                    or item.get("probe_output") != "Version 0.0.79"):
                fail("Playwright requires committed package and lockfiles with the exact probe output")
            validate_playwright_lockfile(ROOT / integrity["lockfile"], ROOT / integrity["package"])
    return True


def validate_catalog(catalog: dict, root: Path = ROOT) -> bool:
    if catalog.get("schema") != "pegasus-harness-artifact-catalog/v3":
        fail("invalid artifact catalog schema")
    if any((root / source).exists() for source in FORBIDDEN_PAYLOAD_SOURCES):
        fail("forbidden payload source is present")
    ids: set[str] = set()
    for entry in catalog.get("artifacts", []):
        identifier, source = entry.get("id"), entry.get("source", "")
        if not identifier or identifier in ids or "judgment-day" in source or "/sergio-" in source or source in FORBIDDEN_PAYLOAD_SOURCES:
            fail("catalog has an excluded or duplicate artifact")
        ids.add(identifier)
        path = root / source
        if not path.is_file() or path.is_symlink() or digest(path) != entry.get("digest"):
            fail(f"catalog source integrity mismatch: {source}")
        if entry.get("executable") and (not is_allowed_executable(source) or not os.access(path, os.X_OK)):
            fail(f"unsupported executable artifact: {source}")
        if entry.get("kind") not in {"file", "json-key", "json-array-item"}:
            fail(f"unsupported artifact kind: {identifier}")
    validate_notifier_lockfile(root)
    return True


def target_paths(home: Path) -> dict[str, Path]:
    return {
        "home": home,
        "opencode_config": home / ".config" / "opencode" / "opencode.json",
        "opencode_root": home / ".config" / "opencode",
        "claude_root": home / ".claude",
        "data": home / ".local" / "share" / "pegasus-harness",
        "journal": home / ".local" / "share" / "pegasus-harness" / "journal-v3.json",
        "dependencies": home / ".local" / "share" / "pegasus-harness" / "dependencies",
    }


def read_config(path: Path) -> dict:
    if not path.exists():
        return {}
    if path.is_symlink():
        fail(f"configuration symlink is user-owned: {path}")
    value = load_json(path)
    if not isinstance(value, dict):
        fail(f"configuration root must be an object: {path}")
    return value


def selected(client: str, entry: dict) -> bool:
    return client == "all" or entry["client"] == client


def expected_probe(item: dict) -> str:
    if item["id"] == "playwright":
        return item["probe_output"]
    return {
        "cbm": "codebase-memory-mcp 0.9.0",
        "engram": "engram 1.20.0",
    }[item["id"]]


def regular_executable(value: object) -> Path | None:
    if not isinstance(value, str):
        return None
    path = Path(value)
    if not path.is_absolute() or path.is_symlink() or not path.is_file() or not os.access(path, os.X_OK):
        return None
    return path.resolve()


def path_stat(path: Path) -> os.stat_result:
    return path.stat()


def trusted_external_browser(value: object, target_home: Path) -> Path:
    """Accept only a root-controlled browser outside the target's control."""
    if not isinstance(value, (str, Path)):
        fail("external browser path is invalid")
    browser = Path(value)
    if not browser.is_absolute() or browser.is_symlink() or not browser.is_file() or not os.access(browser, os.X_OK):
        fail("external browser must be an absolute regular non-symlink executable")
    try:
        browser.relative_to(target_home)
    except ValueError:
        pass
    else:
        fail("external browser must be outside the target home")
    for item in (browser, *browser.parents):
        if item.is_symlink() or not item.is_dir() and item != browser:
            fail("external browser has an unsafe path")
        metadata = path_stat(item)
        if metadata.st_uid != 0:
            fail("external browser and its ancestors must be root-owned")
        if metadata.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            fail("external browser and its ancestors must not be group/world-writable")
    return browser


def successful_probe(command: list[str], expected: str) -> bool:
    try:
        result = subprocess.run(command, text=True, capture_output=True, timeout=PROBE_TIMEOUT, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return result.returncode == 0 and (result.stdout + result.stderr).strip() == expected


def sanitized_probe_output(value: str) -> str:
    """Keep probe failures actionable without exposing unbounded secret-bearing output."""
    redacted = SENSITIVE_PROBE_VALUE.sub(
        lambda match: f"{match.group('key')}{match.group('quote')}{match.group('separator')}<redacted>", value
    )
    redacted = SENSITIVE_BEARER_TOKEN.sub("Bearer <redacted>", redacted)
    if len(redacted) > PROBE_DIAGNOSTIC_LIMIT:
        redacted = redacted[:PROBE_DIAGNOSTIC_LIMIT] + "...<truncated>"
    return repr(redacted)


def compatible_mcp(item: dict, value: object) -> tuple[bool, str | None]:
    if not isinstance(value, dict) or value.get("type") != "local" or not isinstance(value.get("command"), list) or not value["command"]:
        return False, None
    command = value["command"]
    if not all(isinstance(part, str) for part in command):
        return False, None
    executable = regular_executable(command[0])
    if executable is None:
        return False, None
    if item["id"] == "cbm":
        shape_valid = len(command) == 1
    elif item["id"] == "engram":
        shape_valid = command[1:] == ["mcp", "--tools=agent"]
    else:
        entrypoint = Path(command[1]) if len(command) == 2 else None
        shape_valid = entrypoint is not None and not entrypoint.is_symlink() and entrypoint.is_file() and entrypoint.parts[-4:] == ("node_modules", "@playwright", "mcp", "cli.js")
        if shape_valid and not successful_probe([str(executable), "--version"], "v20.0.0"):
            try:
                version = subprocess.run([str(executable), "--version"], text=True, capture_output=True, timeout=PROBE_TIMEOUT, check=False).stdout.strip()
                shape_valid = version.startswith("v") and int(version[1:].split(".", 1)[0]) >= 20
            except (OSError, ValueError, subprocess.TimeoutExpired):
                shape_valid = False
    if item["id"] == "playwright":
        probe_command = [str(executable), command[1], "--version"]
    else:
        probe_command = [str(executable), "--version"]
    if not shape_valid or not successful_probe(probe_command, expected_probe(item)):
        return False, None
    return True, str(executable)


def detect(target: dict[str, Path], client: str) -> dict:
    catalog, contract = load_catalog(), load_contract()
    validate_catalog(catalog)
    validate_contract(contract)
    config = read_config(target["opencode_config"])
    dependencies = []
    for item in contract["dependencies"]:
        existing = config.get("mcp", {}).get(item["config_key"])
        compatible, resolved = compatible_mcp(item, existing)
        dependencies.append({"id": item["id"], "existing": existing, "compatible": compatible, "resolved_path": resolved, "config_key": item["config_key"], "present": existing is not None})
    return {"client": client, "target": {key: str(value) for key, value in target.items()}, "config": config, "dependencies": dependencies,
            "v2_state": (target["data"] / ".pegasus-harness-state.json").exists()}


def plan(state: dict, catalog: dict, contract: dict) -> dict:
    artifacts = []
    config = state["config"]
    for entry in catalog["artifacts"]:
        if not selected(state["client"], entry):
            continue
        if entry["kind"] == "file":
            target = Path(state["target"]["opencode_root" if entry["client"] == "opencode" else "claude_root"]) / entry["target"]
            collision = target.exists() or target.is_symlink()
        else:
            target = Path(state["target"]["opencode_config"])
            collision = entry["key"] in config
        artifacts.append({"id": entry["id"], "kind": entry["kind"], "target": str(target), "key": entry.get("key"),
                          "action": "skip-collision" if collision else "create", "decision": "preserve-user" if collision else "selected",
                          "collision": collision, "dependency": entry.get("dependency")})
    dependencies = []
    by_id = {item["id"]: item for item in state["dependencies"]}
    for item in contract["dependencies"]:
        detected = by_id[item["id"]]
        action = "link-existing" if detected["compatible"] else "skip-incompatible-existing" if detected["present"] else "confirm-required"
        dependencies.append({"id": item["id"], "action": action, "ownership": False,
                              "config_key": item["config_key"], "metadata": item, "detected": detected["existing"], "resolved_path": detected["resolved_path"]})
    return {"schema": "pegasus-harness-plan/v3", "state": state, "artifacts": artifacts, "dependencies": dependencies,
            "remote_mcps": [{**CONTEXT7, "action": "confirm-required" if "context7" not in config.get("mcp", {}) else "skip-collision"}]}


def browser_preflight(plan_value: dict, target: dict[str, Path], browser_path: object = None) -> dict:
    playwright = next(item for item in plan_value["dependencies"] if item["id"] == "playwright")
    if browser_path is not None:
        try:
            browser = trusted_external_browser(browser_path, target["home"])
        except RuntimeError as error:
            return {"ready": False, "browser": None, "reason": str(error)}
        return {"ready": True, "browser": str(browser),
                "reason": "using the supplied root-controlled external browser"}
    candidates = (target["home"] / ".cache" / "ms-playwright" / "chromium", target["home"] / ".local" / "bin" / "chromium")
    browser = next((item for item in candidates if item.exists() and not item.is_symlink()), None)
    return {"ready": browser is not None, "browser": str(browser) if browser else None,
            "reason": "install a compatible browser externally, then retry; Pegasus will not download one"}


def verify_download(item: dict, destination: Path) -> None:
    integrity = item["integrity"]
    actual = digest(destination)
    if "sha256" in integrity and actual != integrity["sha256"]:
        destination.unlink(missing_ok=True)
        fail(f"integrity mismatch for {item['id']}")
    if "npm_sri" in integrity:
        expected = integrity["npm_sri"].removeprefix("sha512-")
        value = base64.b64encode(hashlib.sha512(destination.read_bytes()).digest()).decode()
        if value != expected:
            destination.unlink(missing_ok=True)
            fail(f"SRI mismatch for {item['id']}")


def expected_archive_members(item: dict) -> set[str]:
    if item["id"] == "cbm":
        return {"bin/codebase-memory-mcp"}
    if item["id"] == "engram":
        return set(item["archive_layout"]["members"])
    fail(f"unknown dependency archive layout: {item.get('id')}")


def expected_archive_executables(item: dict) -> dict[str, int]:
    if item["id"] != "engram":
        return {}
    return {name: int(mode, 8) for name, mode in item["archive_layout"]["executables"].items()}


def resolve_release_bundle(source_url: str, release_root: Path) -> Path:
    """Return a regular, non-linked bundle contained by the verified RC root."""
    relative = source_url.removeprefix("release-bundle:")
    path = Path(relative)
    if not source_url.startswith("release-bundle:") or not relative or path.is_absolute() or ".." in path.parts:
        fail("release bundle path is unsafe")
    try:
        root = release_root.absolute()
        if release_root.is_symlink() or not root.is_dir():
            fail("release bundle root is not a real directory")
        candidate = root / path
        ancestors = candidate.relative_to(root).parents
        for current in (root, *(root / ancestor for ancestor in ancestors if ancestor != Path(".")), candidate):
            if stat.S_ISLNK(os.lstat(current).st_mode):
                fail("release bundle path contains a symlink")
        if not candidate.is_file() or candidate.is_symlink():
            fail("release bundle path is missing or not a regular file")
    except (OSError, ValueError):
        fail("release bundle path is outside the verified root")
    return candidate


def safe_extract_archive(archive: Path, destination: Path, expected: set[str], executables: dict[str, int] | None = None) -> None:
    """Extract exactly declared regular members without traversal or links."""
    staging = destination.with_name(destination.name + ".partial")
    executables = executables or {}
    if destination.exists() or destination.is_symlink():
        fail(f"dependency destination already exists: {destination}")
    shutil.rmtree(staging, ignore_errors=True)
    try:
        with tarfile.open(archive, "r:gz") as contents:
            members = contents.getmembers()
            for member in members:
                name = Path(member.name)
                if name.is_absolute() or ".." in name.parts or not member.isfile() or member.issym() or member.islnk():
                    fail("archive contains unsafe member")
            if len(members) != len(expected) or {member.name for member in members} != expected:
                fail("archive members do not match declared layout")
            if any(member.mode & 0o777 != executables[member.name] for member in members if member.name in executables):
                fail("archive executable permissions do not match declared layout")
            for member in members:
                name = Path(member.name)
                output = staging / name
                output.parent.mkdir(parents=True, exist_ok=True)
                source = contents.extractfile(member)
                if source is None: fail("archive member is unreadable")
                with output.open("wb") as handle: shutil.copyfileobj(source, handle)
                output.chmod(member.mode & 0o777)
        staging.replace(destination)
    except Exception:
        shutil.rmtree(staging, ignore_errors=True)
        raise


def probe_dependency(item: dict, destination: Path) -> None:
    command = [part.replace("{dependency}", str(destination)).replace("{node}", "node") for part in item["probe_argv"]]
    try:
        result = subprocess.run(command, text=True, capture_output=True, timeout=PROBE_TIMEOUT, check=False)
    except subprocess.TimeoutExpired:
        fail(f"dependency probe failed for {item['id']}: timed out after {PROBE_TIMEOUT}s")
    except OSError as error:
        fail(f"dependency probe failed for {item['id']}: could not execute ({error.__class__.__name__})")
    expected = expected_probe(item)
    observed = (result.stdout + result.stderr).strip()
    if result.returncode != 0 or observed != expected:
        fail(
            f"dependency probe failed for {item['id']}: exit_code={result.returncode}; "
            f"stdout={sanitized_probe_output(result.stdout)}; stderr={sanitized_probe_output(result.stderr)}"
        )


def npm_isolation_environment(cwd: Path) -> dict[str, str]:
    """Create npm 24-compatible config isolation inside the disposable staging directory."""
    user_config = cwd / ".npmrc.userconfig"
    global_config = cwd / ".npmrc.globalconfig"
    user_config.write_text("", encoding="utf-8")
    global_config.write_text("", encoding="utf-8")
    return {
        "PATH": os.environ.get("PATH", ""),
        "HOME": str(cwd),
        "NPM_CONFIG_CACHE": str(cwd / ".npm-cache"),
        "NPM_CONFIG_REGISTRY": "https://registry.npmjs.org/",
        "NPM_CONFIG_USERCONFIG": str(user_config),
        "NPM_CONFIG_GLOBALCONFIG": str(global_config),
        "NPM_CONFIG_IGNORE_SCRIPTS": "true",
        "npm_config_registry": "https://registry.npmjs.org/",
    }


def run_npm(command: list[str], cwd: Path) -> None:
    environment = npm_isolation_environment(cwd)
    result = subprocess.run(command, cwd=cwd, env=environment, text=True, capture_output=True, timeout=120, check=False)
    if result.returncode:
        fail(f"npm ci failed: {(result.stderr or result.stdout).strip()}")


def install_playwright(item: dict, destination: Path, npm: str = "npm") -> None:
    """Install the committed graph privately and promote only verified node_modules."""
    if destination.exists() or destination.is_symlink():
        fail(f"dependency destination already exists: {destination}")
    validate_playwright_lockfile(ROOT / item["integrity"]["lockfile"], ROOT / item["integrity"]["package"])
    destination.parent.mkdir(parents=True, exist_ok=True)
    staging = Path(tempfile.mkdtemp(prefix=".playwright-npm-", dir=destination.parent))
    try:
        shutil.copyfile(PLAYWRIGHT_PACKAGE_PATH, staging / "package.json")
        shutil.copyfile(PLAYWRIGHT_LOCK_PATH, staging / "package-lock.json")
        run_npm([npm, "ci", "--ignore-scripts"], staging)
        validate_playwright_lockfile(staging / "package-lock.json", staging / "package.json")
        runtime = staging / "node_modules"
        cli = runtime / "@playwright" / "mcp" / "cli.js"
        if not runtime.is_dir() or cli.is_symlink() or not cli.is_file():
            fail("Playwright npm install did not create the expected CLI")
        probe_dependency(item, runtime)
        runtime.replace(destination)
    except Exception:
        shutil.rmtree(destination, ignore_errors=True)
        raise
    finally:
        shutil.rmtree(staging, ignore_errors=True)


def install_dependency(item: dict, destination: Path, archive: Path | None = None, release_root: Path = ROOT) -> None:
    """Verify a private archive, atomically extract it, then validate its runtime."""
    if item["id"] == "playwright":
        fail("Playwright must be installed with the committed npm graph")
    if destination.exists() or destination.is_symlink():
        fail(f"dependency destination already exists: {destination}")
    destination.parent.mkdir(parents=True, exist_ok=True)
    temporary = destination.with_name(destination.name + ".download.partial")
    try:
        if archive is None:
            if item["source_url"].startswith("release-bundle:"):
                archive = resolve_release_bundle(item["source_url"], release_root)
            else:
                with urllib.request.urlopen(item["source_url"], timeout=30) as response, temporary.open("wb") as output:
                    shutil.copyfileobj(response, output)
        if archive is not None:
            shutil.copyfile(archive, temporary)
        verify_download(item, temporary)
        safe_extract_archive(temporary, destination, expected_archive_members(item), expected_archive_executables(item))
        probe_dependency(item, destination)
    except Exception:
        shutil.rmtree(destination, ignore_errors=True)
        try:
            destination.parent.rmdir()
        except OSError:
            pass
        raise
    finally:
        temporary.unlink(missing_ok=True)


def load_journal(target: dict[str, Path]) -> dict:
    if not target["journal"].exists():
        return {"schema": "pegasus-harness-journal/v3", "version": RELEASE, "entries": [], "links": []}
    journal = load_json(target["journal"])
    if (journal.get("schema") != "pegasus-harness-journal/v3" or journal.get("version") != RELEASE
            or not isinstance(journal.get("release"), dict) or not isinstance(journal.get("entries"), list)
            or not isinstance(journal.get("links", []), list)):
        fail("journal is malformed and remains unowned")
    return journal


def write_journal(target: dict[str, Path], journal: dict) -> None:
    owner = target["home"].stat().st_uid
    if owner == 0 or os.geteuid() != owner:
        fail("journal must be written by the non-root target user")
    parent = target["journal"].parent
    parent.mkdir(parents=True, exist_ok=True)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=parent,
                                         prefix=".journal-v3.", suffix=".partial", delete=False) as output:
            temporary = Path(output.name)
            json.dump(journal, output, indent=2)
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        temporary.chmod(0o600)
        os.replace(temporary, target["journal"])
        directory = os.open(parent, os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
        if target["journal"].stat().st_uid != owner:
            fail("journal ownership does not match the target user")
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def validate_rc_release_identity(release_identity: object, release_root: Path) -> dict[str, str]:
    if not isinstance(release_identity, dict) or set(release_identity) != {
            "tag", "archive_name", "archive_sha256", "manifest_sha256", "archive_root"}:
        fail("RC release identity is malformed")
    identity = release_identity
    tag = identity["tag"]
    root = identity["archive_root"]
    if (not isinstance(tag, str) or not RC_TAG.fullmatch(tag)
            or not isinstance(root, str) or root != f"pegasus-harness-{tag}"
            or identity["archive_name"] != f"{root}.tar.gz"
            or any(not isinstance(identity[name], str) or not re.fullmatch(r"[0-9a-f]{64}", identity[name])
                   for name in ("archive_sha256", "manifest_sha256"))):
        fail("RC release identity is invalid")
    resolved_root = release_root.resolve()
    if resolved_root.name.startswith("pegasus-harness-") and resolved_root.name != root:
        fail("RC release identity does not match the extracted release root")
    return identity


def journal_release(release_root: Path, release_identity: dict[str, str] | None = None) -> dict:
    root = release_root.resolve()
    tag = root.name.removeprefix("pegasus-harness-")
    release = {
        "version": RELEASE,
        "tag": tag if RC_TAG.fullmatch(tag) else None,
        "root": root.name,
        "contract_sha256": digest(root / "manifests" / "release-contract.json"),
        "catalog_sha256": digest(root / "manifests" / "artifact-catalog.json"),
    }
    if release_identity is not None:
        release.update(release_identity)
    return release


def source_entry(identifier: str) -> dict:
    return next(item for item in load_catalog()["artifacts"] if item["id"] == identifier)


def apply(plan_value: dict, target: dict[str, Path], confirmed: set[str], browser_ready: bool, declined: set[str] | None = None, release_root: Path = ROOT, release_identity: object = None) -> dict:
    declined = declined or set()
    pending = {item["id"] for item in plan_value["dependencies"] if item["action"] == "confirm-required"} - declined
    if not pending.issubset(confirmed):
        fail("per-dependency confirmation is required before apply")
    playwright = next(item for item in plan_value["dependencies"] if item["id"] == "playwright")
    if playwright["action"] in {"confirm-required", "link-existing"} and "playwright" not in declined and not browser_ready:
        fail("Playwright browser preflight blocks apply; cancel or install externally and retry")
    external_release = release_root.resolve() != ROOT.resolve()
    if external_release and release_identity is None:
        fail("validated RC release identity is required before apply")
    identity = validate_rc_release_identity(release_identity, release_root) if release_identity is not None else None
    journal, created, config = load_journal(target), [], read_config(target["opencode_config"])
    try:
        for dependency in plan_value["dependencies"]:
            if dependency["action"] == "confirm-required" and dependency["id"] in confirmed:
                metadata = dependency["metadata"]
                destination = target["dependencies"] / dependency["id"]
                if metadata["id"] == "playwright":
                    install_playwright(metadata, destination)
                else:
                    install_dependency(metadata, destination, release_root=release_root)
                journal["entries"].append({"id": f"dependency-{metadata['id']}", "release": RELEASE,
                                           "kind": "dependency", "target": str(destination), "key": None,
                                           "source_digest": metadata["integrity"].get("sha256"),
                                           "baseline_digest": directory_digest(destination), "ownership": "owned",
                                           "created_at": dt.datetime.now(dt.timezone.utc).isoformat()})
                created.append(f"dependency-{metadata['id']}")
            elif dependency["action"] == "link-existing":
                journal["links"].append({"id": dependency["id"], "target": dependency["resolved_path"],
                                         "ownership": "non-owning-link"})
        for action in plan_value["artifacts"]:
            if action["action"] != "create" or action.get("dependency") in declined:
                continue
            entry = source_entry(action["id"])
            if entry["id"] == "opencode-mcp" and not confirmed:
                continue
            source = ROOT / entry["source"]
            if entry["kind"] == "file":
                target_file = Path(action["target"])
                target_file.parent.mkdir(parents=True, exist_ok=True)
                target_file.write_bytes(source.read_bytes())
                baseline = digest(target_file)
            else:
                value = load_json(source)[entry["source_key"]]
                if entry["id"] == "opencode-mcp":
                    config_keys = {
                        dependency["config_key"]
                        for dependency in plan_value["dependencies"]
                        if dependency["id"] in confirmed
                    }
                    value = {key: item for key, item in value.items() if key in config_keys}
                config[entry["key"]] = value
                target_file = target["opencode_config"]
                baseline = sha256_bytes(json.dumps(value, sort_keys=True).encode())
            journal["entries"].append({"id": entry["id"], "release": RELEASE, "kind": entry["kind"], "target": str(target_file), "key": entry.get("key"),
                                        "source_digest": entry["digest"], "baseline_digest": baseline, "ownership": "owned",
                                        "created_at": dt.datetime.now(dt.timezone.utc).isoformat()})
            created.append(entry["id"])
        for remote in plan_value["remote_mcps"]:
            if remote["action"] != "confirm-required" or remote["id"] not in confirmed:
                continue
            config.setdefault("mcp", {})[remote["config_key"]] = {"type": "remote", "url": remote["endpoint"], "enabled": True}
            journal["entries"].append({"id": "context7-mcp", "release": RELEASE, "kind": "json-mcp-key", "target": str(target["opencode_config"]), "key": remote["config_key"],
                                        "source_digest": None, "baseline_digest": sha256_bytes(json.dumps(config["mcp"][remote["config_key"]], sort_keys=True).encode()),
                                        "ownership": "owned", "created_at": dt.datetime.now(dt.timezone.utc).isoformat()})
            created.append("context7-mcp")
        if any(item["kind"] != "file" and item["id"] in created for item in plan_value["artifacts"]) or "context7-mcp" in created:
            target["opencode_config"].parent.mkdir(parents=True, exist_ok=True)
            target["opencode_config"].write_text(json.dumps(config, indent=2) + "\n", encoding="utf-8")
        if created:
            if not journal["entries"][:-len(created)]:
                journal["release"] = journal_release(release_root, identity)
            write_journal(target, journal)
    except Exception:
        rollback(target, journal)
        raise
    return {"created": created, "skipped": [item["id"] for item in plan_value["artifacts"] if item["action"] != "create"]}


def rollback(target: dict[str, Path], journal: dict | None = None) -> dict:
    journal = journal or load_journal(target)
    config, removed, preserved = read_config(target["opencode_config"]), [], []
    kept = []
    for entry in reversed(journal["entries"]):
        path = Path(entry["target"])
        if entry["kind"] == "dependency":
            unchanged = path.is_dir() and not path.is_symlink() and directory_digest(path) == entry["baseline_digest"]
            if unchanged:
                shutil.rmtree(path); removed.append(entry["id"])
            else:
                preserved.append(entry["id"]); kept.append(entry)
        elif entry["kind"] == "file":
            unchanged = path.is_file() and not path.is_symlink() and digest(path) == entry["baseline_digest"]
            if unchanged:
                path.unlink(); removed.append(entry["id"])
            else:
                preserved.append(entry["id"]); kept.append(entry)
        elif entry["kind"] == "json-mcp-key":
            value = config.get("mcp", {}).get(entry["key"])
            unchanged = value is not None and sha256_bytes(json.dumps(value, sort_keys=True).encode()) == entry["baseline_digest"]
            if unchanged:
                del config["mcp"][entry["key"]]
                if not config["mcp"]:
                    del config["mcp"]
                removed.append(entry["id"])
            else:
                preserved.append(entry["id"]); kept.append(entry)
        else:
            value = config.get(entry["key"])
            unchanged = value is not None and sha256_bytes(json.dumps(value, sort_keys=True).encode()) == entry["baseline_digest"]
            if unchanged:
                del config[entry["key"]]; removed.append(entry["id"])
            else:
                preserved.append(entry["id"]); kept.append(entry)
    if target["opencode_config"].exists():
        target["opencode_config"].write_text(json.dumps(config, indent=2) + "\n", encoding="utf-8")
    journal["entries"] = list(reversed(kept))
    if journal["entries"]:
        write_journal(target, journal)
    else:
        target["journal"].unlink(missing_ok=True)
    return {"removed": removed, "preserved": preserved}


def validate(target: dict[str, Path]) -> int:
    validate_catalog(load_catalog()); validate_contract(load_contract())
    journal = load_journal(target)
    if journal["entries"]:
        if target["journal"].stat().st_uid != target["home"].stat().st_uid or target["journal"].stat().st_uid == 0:
            fail("journal ownership is not the non-root target user")
        release = journal["release"]
        if (release.get("version") != RELEASE or not isinstance(release.get("root"), str)
                or not all(isinstance(release.get(name), str) and len(release[name]) == 64
                            for name in ("contract_sha256", "catalog_sha256"))):
            fail("journal release identity is malformed and remains unowned")
        if release.get("tag") is not None:
            try:
                validate_rc_release_identity({name: release[name] for name in (
                    "tag", "archive_name", "archive_sha256", "manifest_sha256", "archive_root")}, Path(release["archive_root"]))
            except (KeyError, RuntimeError):
                fail("journal RC release identity is malformed and remains unowned")
        for entry in journal["entries"]:
            try:
                Path(entry["target"]).relative_to(target["home"])
            except (KeyError, ValueError):
                fail("journal entry target is outside the target home")
            if (entry.get("ownership") != "owned" or entry.get("kind") not in {"file", "json-key", "json-array-item", "json-mcp-key", "dependency"}
                    or not isinstance(entry.get("baseline_digest"), str) or len(entry["baseline_digest"]) != 64):
                fail("journal entry is malformed and remains unowned")
        if any(link.get("ownership") != "non-owning-link" or not isinstance(link.get("id"), str)
               or not isinstance(link.get("target"), str) for link in journal["links"]):
            fail("journal link is malformed and remains non-owning")
    print(f"PASS: catalog, provenance, and {len(journal['entries'])} ownership entries are valid")
    return 0


def target_home(user: str) -> Path:
    account = pwd.getpwnam(user)
    home = Path(account.pw_dir)
    if not home.is_dir() or home.stat().st_uid != account.pw_uid:
        fail(f"target home is missing or not owned by {user}: {home}")
    return home


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--home", type=Path, help="test-only target home; never use for another user")
    parser.add_argument("--release-root", type=Path, default=ROOT, help="verified extracted release root")
    parser.add_argument("--release-identity", help="validated RC archive identity from acceptance preflight")
    parser.add_argument("--browser", type=Path, help="root-controlled external browser for Playwright preflight")
    parser.add_argument("--target-user", default=os.environ.get("USER", ""))
    parser.add_argument("--client", choices=(*CLIENTS, "all"), default="opencode")
    parser.add_argument("--confirm", action="append", default=[])
    parser.add_argument("--decline", action="append", default=[])
    commands = parser.add_subparsers(dest="command", required=True)
    for command in ("detect", "plan", "apply", "validate", "uninstall"):
        commands.add_parser(command)
    args = parser.parse_args()
    home = args.home or target_home(args.target_user)
    target = target_paths(home)
    state = detect(target, args.client)
    if args.command == "detect": print(json.dumps(state, indent=2)); return 0
    value = plan(state, load_catalog(), load_contract())
    if args.command == "plan": print(json.dumps(value, indent=2)); return 0
    if args.command == "apply":
        ready = browser_preflight(value, target, args.browser)["ready"]
        try:
            identity = json.loads(args.release_identity) if args.release_identity else None
        except json.JSONDecodeError:
            fail("RC release identity is invalid JSON")
        print(json.dumps(apply(value, target, set(args.confirm), ready, set(args.decline), args.release_root, identity), indent=2)); return 0
    if args.command == "uninstall": print(json.dumps(rollback(target), indent=2)); return 0
    return validate(target)


if __name__ == "__main__":
    try: raise SystemExit(main())
    except (RuntimeError, KeyError, OSError, subprocess.CalledProcessError) as error:
        print(f"ERROR: {error}", file=sys.stderr); raise SystemExit(1)
