#!/usr/bin/env python3
"""Install and validate the portable, user-local Pegasus OpenCode harness."""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import pwd
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SOURCE = ROOT / "source"
INSTALLER_URL = "https://opencode.ai/install"
CBM_INSTALLER_URL = "https://raw.githubusercontent.com/DeusData/codebase-memory-mcp/main/install.sh"
MARKER = ".pegasus-harness-state.json"


def fail(message: str) -> None:
    raise RuntimeError(message)


def target_home(user: str) -> Path:
    try:
        account = pwd.getpwnam(user)
    except KeyError:
        fail(f"target user does not exist: {user}")
    home = Path(account.pw_dir)
    if not home.is_dir() or home.stat().st_uid != account.pw_uid:
        fail(f"target home is missing or not owned by {user}: {home}")
    return home


def run_as_target(user: str, args: list[str]) -> int:
    # The source checkout can be private to the operator. Stage only the
    # sanitized bootstrap inputs in a world-readable, owner-private temporary
    # directory so the actual installer process still runs as the target user.
    staging = Path(tempfile.mkdtemp(prefix="pegasus-harness-bootstrap-", dir="/tmp"))
    staging.chmod(0o755)
    try:
        (staging / "bin").mkdir()
        shutil.copy2(Path(__file__).resolve(), staging / "bin" / "pegasus")
        (staging / "bin" / "pegasus").chmod(0o755)
        shutil.copytree(SOURCE, staging / "source")
        (staging / "tools").mkdir()
        for filename in ("pegasus_skill_registry.py", "pegasus-skill-registry"):
            shutil.copy2(ROOT / "tools" / filename, staging / "tools" / filename)
        command = ["sudo", "-u", user, "-H", "env", f"HOME={target_home(user)}", "PATH=/usr/local/bin:/usr/bin:/bin", sys.executable, str(staging / "bin" / "pegasus"), "--as-target", *args]
        return subprocess.run(command, check=False).returncode
    finally:
        shutil.rmtree(staging, ignore_errors=True)


def home() -> Path:
    value = Path.home()
    if not value.is_dir():
        fail(f"current HOME is not a directory: {value}")
    return value


def paths() -> dict[str, Path]:
    user_home = home()
    config = user_home / ".config" / "opencode"
    data = user_home / ".local" / "share" / "pegasus-harness"
    return {
        "home": user_home,
        "config": config,
        "data": data,
        "state": data / MARKER,
        "backup_root": user_home / ".local" / "share" / "pegasus-harness-backups",
        "bin": user_home / ".local" / "bin",
    }


def resolve_opencode(environment: dict[str, str]) -> Path:
    """Resolve OpenCode without relying on a target shell startup file."""
    discovered = shutil.which("opencode", path=environment.get("PATH"))
    candidates = [
        Path(discovered) if discovered else None,
        home() / ".opencode" / "bin" / "opencode",
        home() / ".local" / "bin" / "opencode",
    ]
    for candidate in candidates:
        if candidate is not None and candidate.is_file() and os.access(candidate, os.X_OK):
            return candidate
    fail("OpenCode executable not found. Install it with `pegasus install` or place it in ~/.opencode/bin or ~/.local/bin.")


def ensure_prerequisites() -> None:
    if sys.platform != "linux":
        fail("Pegasus bootstrap currently supports Linux only")
    for executable in ("curl", "python3"):
        if not shutil.which(executable):
            fail(f"missing prerequisite: {executable}")
    if os.geteuid() == 0:
        fail("internal target mode must run as an unprivileged target user")


def digest(path: Path) -> str:
    import hashlib
    return hashlib.sha256(path.read_bytes()).hexdigest()


def snapshot(target: dict[str, Path]) -> Path:
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    backup = target["backup_root"] / stamp
    backup.mkdir(parents=True, mode=0o700)
    return backup


def save_existing(path: Path, backup: Path, index: int) -> dict[str, str] | None:
    """Back up exactly one collision. Directories are never owned or replaced."""
    if not path.exists() and not path.is_symlink():
        return None
    if path.is_dir():
        fail(f"cannot safely replace directory collision: {path}")
    if path.is_symlink():
        return {"kind": "symlink", "target": os.readlink(path)}
    destination = backup / "owned" / str(index)
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(path, destination, follow_symlinks=False)
    return {"kind": "file", "path": str(destination), "sha256": digest(path)}


def is_expected(entry: dict[str, object]) -> bool:
    path = Path(str(entry["path"]))
    if entry["kind"] == "symlink":
        return path.is_symlink() and os.readlink(path) == entry["target"]
    return path.is_file() and not path.is_symlink() and digest(path) == entry["sha256"]


def restore(entry: dict[str, object]) -> None:
    backup = entry.get("backup")
    if not backup:
        return
    path = Path(str(entry["path"]))
    path.parent.mkdir(parents=True, exist_ok=True)
    if backup["kind"] == "symlink":
        path.symlink_to(str(backup["target"]))
    else:
        shutil.copy2(str(backup["path"]), path, follow_symlinks=False)


def write_owned(path: Path, content: bytes, backup: Path, entries: list[dict[str, object]]) -> None:
    prior = save_existing(path, backup, len(entries))
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(content)
    path.chmod(0o600)
    entries.append({"path": str(path), "kind": "file", "sha256": digest(path), "backup": prior})


def link_owned(path: Path, destination: Path, backup: Path, entries: list[dict[str, object]]) -> None:
    prior = save_existing(path, backup, len(entries))
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists() or path.is_symlink():
        path.unlink()
    path.symlink_to(destination)
    entries.append({"path": str(path), "kind": "symlink", "target": str(destination), "backup": prior})


def clean_config(cbm: Path) -> dict[str, object]:
    template = json.loads((SOURCE / "opencode" / "opencode.json").read_text(encoding="utf-8"))
    template["agent"] = {
        name: value for name, value in template.get("agent", {}).items()
        if not name.startswith(("review-", "jd-"))
    }
    for agent in template["agent"].values():
        if isinstance(agent, dict) and isinstance(agent.get("prompt"), str):
            agent["prompt"] = agent["prompt"].replace("../agents/", "./agents/")
    template["plugin"] = []
    template["mcp"] = {
        "codebase-memory-mcp": {
            "enabled": True,
            "type": "local",
            "command": [str(cbm)],
        }
    }
    template.pop("provider", None)
    return template


def materialize(target: dict[str, Path], backup: Path, cbm: Path) -> None:
    config = target["config"]
    state = target["state"]
    if (config / "opencode.json").exists() and not state.exists():
        fail(f"refusing to overwrite unmanaged OpenCode config: {config / 'opencode.json'}")
    source_files = [
        (source_root, source)
        for source_root in (SOURCE / "opencode" / "prompts", SOURCE / "agents")
        for source in source_root.rglob("*") if source.is_file()
    ]
    destinations = [config / "opencode.json", config / "plugins" / "pegasus-skill-registry.ts", config / "pegasus.env", config / "pegasus-skill-registry.env", target["bin"] / "pegasus"]
    for source_root, source in source_files:
        destination_root = config / ("prompts" if source_root.name == "prompts" else "agents")
        destinations.append(destination_root / source.relative_to(source_root))
    destinations.extend(target["data"] / "bin" / name for name in ("pegasus_skill_registry.py", "pegasus-skill-registry", "pegasus"))
    for destination in destinations:
        if destination.is_dir():
            fail(f"cannot safely replace directory collision: {destination}")
    entries: list[dict[str, object]] = []
    write_owned(config / "opencode.json", (json.dumps(clean_config(cbm), indent=2) + "\n").encode(), backup, entries)
    for source_root, source in sorted(source_files, key=lambda item: item[1].as_posix()):
        destination_root = config / ("prompts" if source_root.name == "prompts" else "agents")
        write_owned(destination_root / source.relative_to(source_root), source.read_bytes(), backup, entries)
    write_owned(config / "plugins" / "pegasus-skill-registry.ts", (SOURCE / "opencode" / "plugins" / "pegasus-skill-registry.ts").read_bytes(), backup, entries)
    data = target["data"]
    for source in (ROOT / "tools" / "pegasus_skill_registry.py", ROOT / "tools" / "pegasus-skill-registry", Path(__file__).resolve()):
        destination = data / "bin" / ("pegasus" if source == Path(__file__).resolve() else source.name)
        write_owned(destination, source.read_bytes(), backup, entries)
        destination.chmod(0o755)
    contract = "\n".join((
        "# Non-secret Pegasus runtime contract. Source this file before starting OpenCode.",
        f"PEGASUS_SKILL_REGISTRY_BIN={data / 'bin' / 'pegasus-skill-registry'}",
        f"PEGASUS_SKILL_ROOTS={config / 'skills'}",
        f"PEGASUS_PLUGIN_ROOT={config / 'plugins'}",
        f"CODEBASE_MEMORY_MCP_BIN={cbm}",
        "# ENGRAM_BIN=engram                 # Set only after installing/configuring Engram.",
        "# PLAYWRIGHT_MCP_CWD=/path/to/project # Set only when Playwright MCP is desired.",
        "# XIAOMI_API_KEY=                    # Set through a secret manager; never store a key here.",
        "",
    ))
    write_owned(config / "pegasus.env", contract.encode(), backup, entries)
    write_owned(config / "pegasus-skill-registry.env", "\n".join((
        f"PEGASUS_SKILL_REGISTRY_BIN={data / 'bin' / 'pegasus-skill-registry'}",
        f"PEGASUS_SKILL_ROOTS={config / 'skills'}",
        "",
    )).encode(), backup, entries)
    link_owned(target["bin"] / "pegasus", data / "bin" / "pegasus", backup, entries)
    state_payload = {
        "schema": "pegasus-harness-install/v2",
        "installed_at_utc": dt.datetime.now(dt.timezone.utc).isoformat(),
        "backup": str(backup),
        "ownership": entries,
    }
    state.parent.mkdir(parents=True, exist_ok=True)
    state.write_text(json.dumps(state_payload, indent=2) + "\n", encoding="utf-8")
    state.chmod(0o600)


def refresh_launcher_internal() -> int:
    """Update only the target-owned launcher after a harness launcher change."""
    ensure_prerequisites()
    target = paths()
    installed = target["data"] / "bin" / "pegasus"
    if not installed.parent.is_dir() or not target["state"].is_file():
        fail("no harness-managed installation found; run `pegasus install` first")
    state = json.loads(target["state"].read_text(encoding="utf-8"))
    if state.get("schema") != "pegasus-harness-install/v2":
        fail("ownership migration required; run `pegasus migrate-ownership` first")
    entry = next((item for item in state["ownership"] if item["path"] == str(installed)), None)
    if entry is None or not is_expected(entry):
        fail("refusing to replace a modified Pegasus launcher")
    installed.write_bytes(Path(__file__).resolve().read_bytes())
    installed.chmod(0o755)
    entry["sha256"] = digest(installed)
    target["state"].write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
    print(f"REFRESHED launcher={target['bin'] / 'pegasus'}")
    return 0


def migrate_ownership_internal() -> int:
    """Adopt only known legacy Pegasus files; never adopt whole directories."""
    ensure_prerequisites()
    target = paths()
    if not target["state"].is_file():
        fail("no legacy harness state found; run `pegasus install` first")
    legacy = json.loads(target["state"].read_text(encoding="utf-8"))
    if legacy.get("schema") == "pegasus-harness-install/v2":
        print("OWNERSHIP already-current")
        return 0
    backup = Path(str(legacy.get("backup", "")))
    entries: list[dict[str, object]] = []

    def adopt(path: Path, relative: Path) -> None:
        if not path.exists() and not path.is_symlink():
            return
        if path.is_dir():
            return
        prior: dict[str, str] | None = None
        saved = backup / relative
        if saved.is_file() and not saved.is_symlink():
            prior = {"kind": "file", "path": str(saved), "sha256": digest(saved)}
        elif saved.is_symlink():
            prior = {"kind": "symlink", "target": os.readlink(saved)}
        if path.is_symlink():
            entries.append({"path": str(path), "kind": "symlink", "target": os.readlink(path), "backup": prior})
        else:
            entries.append({"path": str(path), "kind": "file", "sha256": digest(path), "backup": prior})

    config = target["config"]
    for relative in (Path("opencode.json"), Path("pegasus.env"), Path("pegasus-skill-registry.env"), Path("plugins/pegasus-skill-registry.ts")):
        adopt(config / relative, relative)
    for root, source_root in ((Path("prompts"), SOURCE / "opencode" / "prompts"), (Path("agents"), SOURCE / "agents")):
        for source in source_root.rglob("*"):
            if source.is_file():
                relative = source.relative_to(source_root)
                adopt(config / root / relative, root / relative)
    data = target["data"]
    for name in ("pegasus_skill_registry.py", "pegasus-skill-registry", "pegasus"):
        adopt(data / "bin" / name, Path("data") / "bin" / name)
    adopt(target["bin"] / "pegasus", Path("local-bin-pegasus"))
    target["state"].write_text(json.dumps({"schema": "pegasus-harness-install/v2", "installed_at_utc": legacy.get("installed_at_utc"), "backup": str(backup), "ownership": entries, "migrated_from": legacy.get("schema")}, indent=2) + "\n", encoding="utf-8")
    print(f"MIGRATED ownership={len(entries)} backup={backup}")
    return 0


def install_internal(args: argparse.Namespace) -> int:
    ensure_prerequisites()
    target = paths()
    if not SOURCE.is_dir():
        fail("installer source template is unavailable; rerun from the harness checkout")
    if not args.skip_opencode_install:
        subprocess.run(["bash", "-c", f"curl --proto '=https' --tlsv1.2 -fsSL {INSTALLER_URL} | bash"], check=True)
    if not args.skip_cbm_install:
        subprocess.run(["bash", "-c", f"curl --proto '=https' --tlsv1.2 -fsSL {CBM_INSTALLER_URL} | bash -s -- --skip-config"], check=True)
    cbm = target["bin"] / "codebase-memory-mcp"
    if not cbm.is_file() or not os.access(cbm, os.X_OK):
        fail(f"CBM install did not produce an executable: {cbm}")
    if target["state"].is_file():
        state = json.loads(target["state"].read_text(encoding="utf-8"))
        if state.get("schema") != "pegasus-harness-install/v2":
            fail("ownership migration required; run `pegasus migrate-ownership` before install")
        modified = [entry["path"] for entry in state["ownership"] if not is_expected(entry)]
        if modified:
            fail("refusing to overwrite modified managed assets: " + ", ".join(modified))
        print("INSTALLED already-current")
        return 0
    backup = snapshot(target)
    materialize(target, backup, cbm)
    print(f"INSTALLED config={target['config']} backup={backup}")
    return 0


def validate_internal() -> int:
    ensure_prerequisites()
    target = paths()
    errors: list[str] = []
    warnings: list[str] = []
    config_path = target["config"] / "opencode.json"
    state: dict[str, object] = {}
    if not target["state"].is_file():
        errors.append("missing harness installation state")
    else:
        try:
            state = json.loads(target["state"].read_text(encoding="utf-8"))
            if state.get("schema") != "pegasus-harness-install/v2":
                errors.append("ownership migration required")
            else:
                for entry in state.get("ownership", []):
                    if not is_expected(entry): warnings.append(f"managed asset modified; uninstall will preserve it: {entry['path']}")
        except (OSError, json.JSONDecodeError) as error:
            errors.append(f"invalid ownership manifest: {error}")
    try:
        config = json.loads(config_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        errors.append(f"invalid OpenCode config JSON: {error}")
        config = {}
    for name, agent in config.get("agent", {}).items():
        if name.startswith(("review-", "jd-")): errors.append(f"native review agent is active: {name}")
        prompt = agent.get("prompt") if isinstance(agent, dict) else None
        if isinstance(prompt, str) and prompt.startswith("{file:") and prompt.endswith("}"):
            candidate = (config_path.parent / prompt[6:-1]).resolve()
            if not candidate.is_file(): errors.append(f"unresolved relative prompt: {name} -> {prompt}")
    if "codebase-memory-mcp" not in config.get("mcp", {}): errors.append("CBM MCP is not configured")
    cbm = target["bin"] / "codebase-memory-mcp"
    if not cbm.is_file() or not os.access(cbm, os.X_OK): errors.append("CBM binary unavailable")
    try:
        resolve_opencode(os.environ.copy())
    except RuntimeError as error:
        errors.append(str(error))
    managed_scan = [target["config"], target["data"]]
    for root in managed_scan:
        if root.exists():
            for path in root.rglob("*"):
                legacy_name = "gent" + "le-ai"
                if path.is_file() and path.read_text(encoding="utf-8", errors="ignore").lower().find(legacy_name) >= 0:
                    errors.append(f"forbidden legacy runtime reference: {path}")
                retired_graph = "code" + "graph"
                if path.is_file() and retired_graph in path.read_text(encoding="utf-8", errors="ignore").lower():
                    errors.append(f"forbidden {retired_graph} reference: {path}")
    with tempfile.TemporaryDirectory(prefix="pegasus-registry-") as temporary:
        project = Path(temporary) / "project"
        skill = project / "skills" / "portable" / "SKILL.md"
        skill.parent.mkdir(parents=True)
        skill.write_text("---\nname: portable\ndescription: portable registry smoke skill\n---\n", encoding="utf-8")
        generator = target["data"] / "bin" / "pegasus-skill-registry"
        result = subprocess.run([str(generator), "--project-root", str(project), "--skill-root", str(project / "skills")], text=True, capture_output=True, check=False)
        registry = project / ".atl" / "skill-registry.md"
        if result.returncode or not registry.is_file() or "`portable`" not in registry.read_text(encoding="utf-8"):
            errors.append(f"registry generation failed: {result.stderr.strip() or result.stdout.strip()}")
        if cbm.is_file():
            help_result = subprocess.run([str(cbm), "--help"], text=True, capture_output=True, check=False)
            if help_result.returncode: errors.append("CBM help command failed")
            index_result = subprocess.run([str(cbm), "cli", "index_repository", "--repo-path", str(project), "--mode", "fast"], text=True, capture_output=True, check=False)
            if index_result.returncode: errors.append(f"CBM temporary-project index failed: {index_result.stderr.strip()}")
    for variable, label in (("ENGRAM_BIN", "Engram"), ("PLAYWRIGHT_MCP_CWD", "Playwright"), ("XIAOMI_API_KEY", "model provider")):
        if not os.environ.get(variable): warnings.append(f"OPTIONAL EXTERNAL PENDING: {label} ({variable} is not configured)")
    warnings.extend(("OPTIONAL EXTERNAL PENDING: Jira remote MCP requires a target-user authentication flow", "OPTIONAL EXTERNAL PENDING: Figma MCP is not installed/configured"))
    for item in warnings: print(f"WARNING: {item}")
    if errors:
        for item in errors: print(f"BLOCKING: {item}")
        return 1
    print("PASS: config JSON, relative prompts, Pegasus registry, no legacy/native-review runtime assets, and CBM smoke checks passed")
    return 0


def uninstall_internal() -> int:
    target = paths()
    if not target["state"].is_file(): fail("no harness-managed installation state found")
    state = json.loads(target["state"].read_text(encoding="utf-8"))
    if state.get("schema") != "pegasus-harness-install/v2":
        fail("ownership migration required; run `pegasus migrate-ownership` before uninstall")
    retained: list[dict[str, object]] = []
    for entry in reversed(state["ownership"]):
        path = Path(str(entry["path"]))
        if not is_expected(entry):
            retained.append(entry)
            print(f"WARNING: preserved modified managed asset: {path}")
            continue
        path.unlink(missing_ok=True)
        restore(entry)
    if retained:
        state["ownership"] = list(reversed(retained))
        target["state"].write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
        print("PARTIAL: modified managed assets were preserved; restore or remove them before retrying uninstall")
        return 1
    target["state"].unlink()
    for directory in (target["data"] / "bin", target["data"], target["config"] / "plugins", target["config"] / "prompts", target["config"] / "agents"):
        try: directory.rmdir()
        except OSError: pass
    print(f"UNINSTALLED restored_backup={state['backup']}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--as-target", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--target-user", default=os.environ.get("USER", ""))
    subparsers = parser.add_subparsers(dest="command", required=True)
    install = subparsers.add_parser("install")
    install.add_argument("--skip-opencode-install", action="store_true")
    install.add_argument("--skip-cbm-install", action="store_true")
    subparsers.add_parser("validate")
    subparsers.add_parser("uninstall")
    subparsers.add_parser("refresh-launcher")
    subparsers.add_parser("migrate-ownership")
    run = subparsers.add_parser("run")
    run.add_argument("run_command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if not args.target_user: fail("--target-user is required")
    current_user = pwd.getpwuid(os.geteuid()).pw_name
    if not args.as_target and args.target_user != current_user:
        return run_as_target(args.target_user, ["--as-target", *sys.argv[1:]])
    if args.command == "install": return install_internal(args)
    if args.command == "validate": return validate_internal()
    if args.command == "uninstall": return uninstall_internal()
    if args.command == "refresh-launcher": return refresh_launcher_internal()
    if args.command == "migrate-ownership": return migrate_ownership_internal()
    if args.command == "run":
        if args.run_command[:1] == ["--"]:
            args.run_command = args.run_command[1:]
        if not args.run_command: fail("run requires a command after --")
        environment = os.environ.copy()
        for line in (paths()["config"] / "pegasus.env").read_text(encoding="utf-8").splitlines():
            if "=" in line and not line.lstrip().startswith("#"):
                key, value = line.split("=", 1); environment.setdefault(key, value)
        if args.run_command[0] == "opencode":
            executable = resolve_opencode(environment)
            environment["PATH"] = f"{executable.parent}:{environment.get('PATH', '')}"
            args.run_command[0] = str(executable)
        return subprocess.run(args.run_command, env=environment, check=False).returncode
    return 2


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (RuntimeError, subprocess.CalledProcessError) as error:
        print(f"ERROR: {error}", file=sys.stderr)
        raise SystemExit(1)
